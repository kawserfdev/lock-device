<?xml version="1.0" encoding="utf-8"?>
<!--
  Full-screen, non-dismissible Location Compliance screen.

  Shown by LocationComplianceCoordinator when the user has disabled Device
  Location and the 2-minute grace countdown has expired. Uses Material 3
  components (MaterialCardView, MaterialButton) — requires the
  com.google.android.material dependency declared in build.gradle.kts.

  Layout structure (top-to-bottom):
    - Warning icon (location_off vector)
    - Title ("Location Required")
    - Description
    - Countdown (large, monospace) — hidden when expired
    - Status card:
        - Current Location Status (ON / OFF)
        - Device Status (Locked / Unlocked)
        - Compliance Status (state name)
    - Button row:
        - Enable Location (primary, opens Location Settings)
        - Retry Detection (secondary, manual refresh)
    - Emergency Contact (text button, opens dialer)

  The Activity pins itself via Lock Task Mode and intercepts the back
  gesture, so the user cannot dismiss this screen by pressing Back or Home.
  The countdown and status fields refresh every second / 2 seconds from the
  coordinator.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- Warning icon -->
        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="16dp"
            android:contentDescription="@string/location_compliance_icon_description"
            android:src="@android:drawable/ic_menu_mylocation"
            app:tint="?attr/colorError" />

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/location_compliance_title"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="?attr/colorOnBackground"
            android:textStyle="bold" />

        <!-- Description -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/location_compliance_message"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnBackground" />

        <!-- Countdown -->
        <TextView
            android:id="@+id/compliance_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="monospace"
            android:textAppearance="?attr/textAppearanceDisplayMedium"
            android:textColor="?attr/colorError"
            android:textStyle="bold"
            tools:ignore="UnusedAttribute"
            tools:text="2:00" />

        <!-- Status card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Current Location Status row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/location_compliance_label_location_status"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/compliance_location_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/colorError"
                        android:textStyle="bold"
                        tools:text="OFF" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="8dp"
                    android:background="?attr/colorOutline" />

                <!-- Device Status row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/location_compliance_label_device_status"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/compliance_device_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold"
                        tools:text="Unlocked" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="8dp"
                    android:background="?attr/colorOutline" />

                <!-- Compliance Status row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/location_compliance_label_compliance_status"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/compliance_compliance_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold"
                        tools:text="COMPLIANCE_SCREEN" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Enable Location (primary) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/compliance_btn_enable_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/location_compliance_open_settings"
            app:icon="@android:drawable/ic_menu_mylocation" />

        <!-- Retry Detection (secondary) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/compliance_btn_retry"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/location_compliance_retry" />

        <!-- Emergency Contact (text) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/compliance_btn_emergency"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/location_compliance_emergency" />

    </LinearLayout>
</ScrollView>
